{
  "name": "borodutch-book",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "bun run generate-css-types && vite",
    "build": "bun run generate-css-types && tsc && vite build",
    "pretty": "prettier --check src",
    "lint": "bun run pretty && eslint --max-warnings 0 --ext ts,tsx,json src",
    "generate-css-types": "node node_modules/.bin/tailwindcss-classnames -o src/classnames/tailwind.ts && prettier --write src/classnames/tailwind.ts",
    "preview": "bun run build && vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "preact": "^10.15.1",
    "preact-i18n": "preactx",
    "react-toastify": "^9.1.3",
    "valtio": "^1.10.6",
    "viem": "^2.0.0",
    "wouter": "^2.11.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.5.0",
    "@types/preact-i18n": "^2.3.2",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-no-relative-import-paths": "^1.5.2",
    "eslint-plugin-preact-i18n": "^1.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-valtio": "^0.8.0",
    "postcss": "^8.4.25",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^5.9.2",
    "tailwindcss": "^3.3.2",
    "tailwindcss-classnames": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^4.2.0"
  }
}
